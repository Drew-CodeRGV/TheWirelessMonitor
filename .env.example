# Email Newsletter Monitor Configuration
# Copy this file to .env and fill in your credentials

# Gmail account for monitoring newsletters
EMAIL_ADDRESS=wifinewsletters@gmail.com

# App password (NOT your regular Gmail password)
# Get from: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_16_char_app_password_here

# IMAP server (Gmail)
IMAP_SERVER=imap.gmail.com

# Check interval in minutes (for continuous monitoring)
CHECK_INTERVAL=30
